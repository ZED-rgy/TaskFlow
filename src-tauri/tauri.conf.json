{
    "build": {
        "beforeDevCommand": "npm.cmd run dev:renderer",
        "beforeBuildCommand": "npm.cmd run build:renderer",
        "devPath": "http://localhost:5173",
        "distDir": "../dist",
        "withGlobalTauri": true
    },
    "package": {
        "productName": "小光任务",
        "version": "0.2.0"
    },
    "tauri": {
        "allowlist": {
            "all": false,
            "dialog": {
                "all": true
            },
            "fs": {
                "all": false
            },
            "notification": {
                "all": true
            },
            "window": {
                "all": true
            },
            "globalShortcut": {
                "all": true
            }
        },
        "bundle": {
            "active": true,
            "targets": [
                "nsis"
            ],
            "identifier": "com.personal.taskflow-lite",
            "icon": [
                "../assets/icon.ico"
            ],
            "windows": {
                "webviewInstallMode": {
                    "type": "embedBootstrapper"
                }
            }
        },
        "security": {
            "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'"
        },
        "systemTray": {
            "iconPath": "../assets/icon.ico",
            "iconAsTemplate": false
        },
        "windows": [
            {
                "title": "小光任务",
                "width": 1100,
                "height": 720,
                "minWidth": 680,
                "minHeight": 480,
                "decorations": false,
                "transparent": false,
                "resizable": true
            }
        ]
    }
}
