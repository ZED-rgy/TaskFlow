{
  "build": {
    "beforeDevCommand": "npm.cmd run dev:web",
    "beforeBuildCommand": "npm.cmd run build:web",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "../assets/icon.ico"
    ]
  },
  "productName": "小光任务",
  "mainBinaryName": "小光任务",
  "version": "0.2.1",
  "identifier": "com.personal.taskflow-lite",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; connect-src ipc: http://ipc.localhost https://qbcuiciskagmhnoqmmhy.supabase.co wss://qbcuiciskagmhnoqmmhy.supabase.co"
    },
    "windows": [
      {
        "title": "小光任务",
        "width": 1100,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "useHttpsScheme": true
      }
    ]
  }
}
